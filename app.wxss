/* ===== Swiss Minimalism — Teal & Mint ===== */
page {
  --bg: #F0FDFA;
  --card-bg: #ffffff;
  --text: #134E4A;
  --text-secondary: #5B8A87;
  --text-tertiary: #94B8B5;
  --accent: #0D9488;
  --accent-light: #CCFBF1;
  --cta: #F97316;
  --red: #EF4444;
  --orange: #F97316;
  --yellow: #EAB308;
  --green: #22C55E;
  --separator: rgba(19,78,74,0.06);
  --shadow: 0 2rpx 12rpx rgba(19,78,74,0.06);
  --radius: 24rpx;
  --radius-sm: 20rpx;
  --radius-pill: 980rpx;

  background: var(--bg);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: var(--text);
}

/* ===== 搜索栏 ===== */
.search-bar {
  display: flex; align-items: center; gap: 12rpx;
  background: var(--accent-light); border-radius: var(--radius-sm);
  padding: 18rpx 24rpx; margin: 24rpx 36rpx;
}
.search-bar .search-icon { width: 32rpx; height: 32rpx; opacity: 0.35; flex-shrink: 0; }
.search-bar input {
  flex: 1; border: none; outline: none; background: transparent;
  font-size: 28rpx; color: var(--text); font-family: inherit;
}

/* ===== 分段控制器 ===== */
.segment {
  display: flex; background: #e5e5ea; border-radius: var(--radius-sm);
  padding: 4rpx; margin: 0 36rpx 24rpx;
}
.segment-item {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 26rpx; font-weight: 500; color: var(--text-secondary);
  border-radius: 16rpx; font-family: inherit;
}
.segment-item.active {
  background: #fff; color: var(--text);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.segment-count { font-size: 22rpx; margin-left: 6rpx; opacity: 0.5; }

/* ===== 分类筛选 ===== */
.chips-scroll {
  display: flex; gap: 20rpx; padding: 0 36rpx 28rpx;
  white-space: nowrap; width: auto; overflow-x: scroll;
}
.chip {
  display: inline-flex; align-items: center; padding: 18rpx 40rpx;
  border-radius: var(--radius-pill); border: 2rpx solid #d2d2d7;
  font-size: 28rpx; font-weight: 500; color: var(--text-secondary);
  background: transparent; flex-shrink: 0;
  line-height: 1.3; box-sizing: border-box;
}
.chip.active { background: var(--text); color: #fff; border-color: var(--text); }

/* ===== 列表 ===== */
.list { padding: 0 20rpx 280rpx; }

/* ===== 卡片 ===== */
.card {
  background: var(--card-bg); border-radius: var(--radius);
  padding: 32rpx; margin: 0 16rpx 20rpx;
  box-shadow: var(--shadow); position: relative; overflow: hidden;
}
.card::before {
  content: ''; position: absolute; left: 0; top: 40rpx; bottom: 40rpx;
  width: 6rpx; border-radius: 0 4rpx 4rpx 0;
}
.card.safe::before { background: var(--green); }
.card.warning::before { background: var(--yellow); }
.card.caution::before { background: var(--orange); }
.card.urgent::before { background: var(--red); }
.card.expired::before { background: #d1d1d6; }

.card-hd {
  display: flex; justify-content: space-between; align-items: flex-start;
}
.card-name {
  font-size: 34rpx; font-weight: 600; color: var(--text);
  line-height: 1.3; flex: 1; min-width: 0; word-break: break-all;
}
.card-badge-wrap {
  display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; margin-left: 16rpx;
}

/* ===== 徽章 ===== */
.badge {
  display: inline-flex; align-items: center; padding: 6rpx 20rpx;
  border-radius: var(--radius-pill); font-size: 22rpx; font-weight: 600;
  white-space: nowrap; flex-shrink: 0; line-height: 1.4;
}
.badge-warning { background: #FEFCE8; color: #854D0E; }
.badge-caution { background: #FFF7ED; color: #C2410C; }
.badge-urgent { background: #FEF2F2; color: #DC2626; }
.badge-expired { background: #F1F5F9; color: #94A3B8; }

/* ===== 卡片操作按钮 ===== */
.card-acts { display: flex; gap: 20rpx; flex-shrink: 0; }
.act-btn {
  width: 56rpx; height: 56rpx; border-radius: 50%; background: #f3f3f5;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; color: var(--text-secondary); font-family: inherit;
  line-height: 1;
}
.act-del:active { background: #fee2e2; color: var(--red); }

/* ===== 卡片详情 ===== */
.card-meta { display: flex; gap: 48rpx; margin-top: 20rpx; flex-wrap: wrap; }
.meta-col { display: flex; flex-direction: column; gap: 4rpx; }
.meta-label { font-size: 20rpx; color: var(--text-tertiary); letter-spacing: 1rpx; font-weight: 500; }
.meta-val { font-size: 26rpx; color: var(--text-secondary); font-weight: 500; }
.meta-val.urgent { color: var(--red); font-weight: 600; }

/* ===== 物品位置标签 ===== */
.loc-tag {
  display: flex; align-items: center; gap: 10rpx; margin-top: 20rpx;
  padding: 16rpx 20rpx; background: var(--accent-light);
  border-radius: 14rpx; font-size: 26rpx; color: var(--accent); font-weight: 500;
}
.loc-tag .loc-icon { font-size: 28rpx; flex-shrink: 0; }
.loc-tag .loc-text { word-break: break-all; }

/* ===== 空状态 ===== */
.empty-state {
  display: flex; flex-direction: column; align-items: center;
  padding: 120rpx 60rpx; gap: 20rpx;
}
.empty-state text { font-size: 28rpx; color: var(--text-secondary); }
.empty-icon { font-size: 80rpx; opacity: 0.5; }

/* ===== FAB ===== */
.fab {
  position: fixed; bottom: 200rpx; right: 40rpx;
  width: 100rpx; height: 100rpx; border-radius: 50%;
  background: var(--cta); color: #fff; font-size: 60rpx;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(249,115,22,0.35);
  z-index: 40; font-weight: 300; line-height: 1; padding-bottom: 6rpx;
}

/* ===== 表单 ===== */
.form-group { margin: 0 36rpx 28rpx; }
.form-label {
  font-size: 26rpx; font-weight: 600; color: var(--text-secondary);
  margin-bottom: 12rpx; display: block;
}
.form-input {
  width: 100%; padding: 26rpx 28rpx; border: 2rpx solid #d2d2d7;
  border-radius: 16rpx; font-size: 30rpx; color: var(--text);
  background: #fff; box-sizing: border-box; font-family: inherit;
  line-height: 1.4; height: auto; min-height: 88rpx;
}
.stepper-row { display: flex; align-items: center; }
.stepper {
  display: flex; align-items: center; background: #f3f3f5;
  border-radius: 14rpx; overflow: hidden; flex-shrink: 0;
}
.stepper-btn {
  width: 76rpx; height: 68rpx; display: flex; align-items: center;
  justify-content: center; font-size: 34rpx; color: var(--text);
  font-family: inherit; background: transparent; border: none;
  padding: 0; line-height: 1; font-weight: 400;
}
.stepper-btn:active { background: #e5e5ea; }
.stepper-val {
  min-width: 80rpx; text-align: center; font-size: 32rpx;
  font-weight: 600; background: #fff; line-height: 68rpx;
}
.stepper-unit { flex: 1; margin-left: 20rpx; min-height: 88rpx; font-size: 30rpx; padding: 26rpx 28rpx; }
.chip-add {
  display: inline-flex; align-items: center; justify-content: center;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  border: 3rpx dashed #c7c7cc; background: transparent;
  font-size: 36rpx; color: var(--text-tertiary); flex-shrink: 0;
  line-height: 1; font-weight: 300;
}

/* ===== 按钮 ===== */
.btn-primary {
  display: block; width: 100%; padding: 28rpx;
  border-radius: 28rpx; background: var(--accent);
  color: #fff; font-size: 32rpx; font-weight: 600; border: none;
  text-align: center; font-family: inherit; box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(13,148,136,0.25);
  transition: all 0.2s;
}
.btn-primary:active { background: #0F766E; transform: scale(0.98); }
.btn-ghost {
  display: block; width: 100%; padding: 28rpx;
  border-radius: 28rpx; background: var(--accent-light);
  color: var(--accent); font-size: 32rpx; font-weight: 500;
  border: none; text-align: center; font-family: inherit;
  transition: all 0.2s;
}
.btn-ghost:active { background: rgba(13,148,136,0.15); transform: scale(0.98); }

.btn-outline {
  display: inline-flex; align-items: center; padding: 14rpx 32rpx;
  border-radius: var(--radius-pill); border: 2rpx solid #d2d2d7;
  background: transparent; color: var(--text-secondary);
  font-size: 26rpx; font-weight: 500; font-family: inherit;
  transition: all 0.2s;
}
.btn-outline:active { border-color: var(--accent); color: var(--accent); background: var(--accent-light); }

.form-buttons { padding: 24rpx 36rpx 60rpx; display: flex; flex-direction: column; gap: 20rpx; }

/* ===== 弹窗 ===== */
.modal-mask {
  position: fixed; inset: 0; background: rgba(0,0,0,0.3);
  z-index: 200; display: flex; align-items: flex-end;
}
.modal-sheet {
  width: 100%; background: #fff; border-radius: 48rpx 48rpx 0 0;
  padding: 16rpx 0 0; max-height: 85vh; overflow-y: auto;
}
.modal-handle {
  width: 72rpx; height: 10rpx; background: #d2d2d7;
  border-radius: 6rpx; margin: 0 auto 32rpx;
}
.modal-title {
  font-size: 34rpx; font-weight: 600; text-align: center;
  padding: 0 32rpx 32rpx; color: var(--text);
}

/* ===== 设置页 ===== */
.section-header {
  font-size: 24rpx; color: var(--text-secondary); padding: 32rpx 36rpx 12rpx;
  letter-spacing: 1rpx; font-weight: 500;
}
.settings-section { margin: 0 36rpx 24rpx; }
.settings-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 32rpx; background: #fff; border-bottom: 1rpx solid var(--separator);
}
.settings-row:first-child { border-radius: var(--radius) var(--radius) 0 0; }
.settings-row:last-child { border-radius: 0 0 var(--radius) var(--radius); border-bottom: none; }
.settings-row:only-child { border-radius: var(--radius); }
.settings-row:active { background: rgba(0,0,0,0.02); }
.row-left { display: flex; align-items: center; gap: 20rpx; }
.row-icon { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.row-label { font-size: 30rpx; color: var(--text); }
.row-value { font-size: 26rpx; color: var(--text-secondary); }
.row-arrow { font-size: 32rpx; color: var(--text-tertiary); line-height: 1; }

/* ===== 提醒方案 ===== */
.reminder-preset {
  display: flex; gap: 16rpx; padding: 0 36rpx 32rpx;
}
.reminder-card {
  flex: 1; display: flex; flex-direction: column; align-items: center;
  padding: 28rpx 16rpx 24rpx; border-radius: var(--radius);
  background: #fff; box-shadow: var(--shadow); gap: 12rpx;
  position: relative; overflow: hidden;
}
.reminder-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0;
  height: 8rpx;
}
.reminder-card.red::before { background: #EF4444; }
.reminder-card.orange::before { background: #F97316; }
.reminder-card.yellow::before { background: #EAB308; }
.reminder-card.green::before { background: #22C55E; }
.reminder-card.teal::before { background: #0D9488; }
.reminder-card.blue::before { background: #3B82F6; }
.reminder-card.purple::before { background: #8B5CF6; }
.reminder-card.pink::before { background: #EC4899; }
.reminder-days {
  font-size: 48rpx; font-weight: 800; color: var(--text); letter-spacing: -2rpx; line-height: 1;
}
.reminder-label {
  font-size: 22rpx; font-weight: 500; color: var(--text-secondary);
}
.dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.dot-red { background: var(--red); }
.dot-orange { background: var(--orange); }
.dot-yellow { background: var(--yellow); }
.reminder-preset .row-del {
  position: absolute; top: 6rpx; right: 6rpx;
  width: 44rpx; height: 44rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: var(--text-tertiary); background: rgba(0,0,0,0.06);
  line-height: 1; z-index: 5;
}
.reminder-add-btn {
  display: inline-flex; align-items: center; justify-content: center;
  width: 100%; padding: 24rpx; border-radius: var(--radius);
  border: 2rpx dashed #c7c7cc; background: transparent;
  font-size: 26rpx; font-weight: 500; color: var(--text-secondary);
  font-family: inherit;
}
